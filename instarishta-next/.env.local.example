# ════════════════════════════════════════════════════════════════════════════
# InstaRishta — required environment variables
# ════════════════════════════════════════════════════════════════════════════
# Copy to .env.local and fill in. .env.local is gitignored.

# ── Supabase (data storage) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://cxgxyqxeakjrghfzkuko.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_C2qwOBB0NvHL0KRGwpXBQg_UGZFoCis
# Service role — server-only writes. Get from Supabase Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# ── better-auth ────────────────────────────────────────────────────────────
# Direct Postgres connection. Supabase Dashboard → Project Settings →
# Database → Connection string → "URI" tab → Mode: Transaction (port 6543).
# It looks like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Random 32+ char string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical base URL. http://localhost:3000 in dev, https://instarishta.me in prod.
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (paired with NEXT_PUBLIC_GOOGLE_CLIENT_ID) ────────────────
# Cloud Console → APIs & Services → Credentials → your Web client → Client secret.
# Authorized redirect URI on that client MUST include:
#   {BETTER_AUTH_URL}/api/auth/callback/google
# So in dev that's http://localhost:3000/api/auth/callback/google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Firebase Phone Auth (SMS OTP sign-in) — OPTIONAL ───────────────────────
# Why Firebase and not an SMS gateway: sending A2P SMS to Indian numbers needs
# DLT (TRAI) registration under a registered entity. With Firebase, GOOGLE is
# the sender of record and owns that registration, so phone OTP works without a
# registered firm. Firebase only VERIFIES the number here — the session, the
# user row and every API stay better-auth.
#
# Setup: console.firebase.google.com → new project → Build → Authentication →
# Sign-in method → enable "Phone". Then Project settings → General → Your apps →
# add a Web app, and copy the config values below. Under Authentication →
# Settings → Authorized domains, add localhost, instarishta.me and
# www.instarishta.me — reCAPTCHA refuses to run on an unlisted domain.
#
# Billing: phone auth needs the Blaze (pay-as-you-go) plan past the free daily
# quota. A card is required; no company or GST is.
#
# These three are PUBLIC by design (Firebase web config is not a secret — access
# is gated by the authorized-domain list and reCAPTCHA, not by the key).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Server-side token verification. Same value as NEXT_PUBLIC_FIREBASE_PROJECT_ID;
# set separately so the server never depends on a client-visible var. Leave every
# one of these blank and phone sign-in is hidden in the UI and refused by the API.
FIREBASE_PROJECT_ID=

# ── Resend (magic-link emails) ─────────────────────────────────────────────
# Sign up at resend.com, get an API key. Free tier: 3000 emails/mo.
RESEND_API_KEY=
# Sender. Until you verify a custom domain, use resend.dev as a fallback.
RESEND_FROM=InstaRishta <onboarding@resend.dev>

# ── Admin allowlist for /nizam access ──────────────────────────────────────
# Comma-separated emails. Users with matching email are admins.
ADMIN_EMAILS=

# ── Optional: 8G Firewall mode ──────────────────────────────────────────────
# 1 = audit (log but don't block). Unset = enforce (block with 403).
FIREWALL_SAFE_MODE=

# ── Optional: Telegram contact notifications ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_TARGET=
TELEGRAM_MESSAGE_THREAD_ID=

# ── Payment confirmation via Telegram (REQUIRED for /pay checkout) ──────────
# Credits are granted the moment a member says they paid, then confirmed or
# revoked by an admin tapping ✅ / ❌ on the Telegram message. Both values gate
# /api/telegram/webhook and BOTH fail closed — leave either unset and no tap is
# ever accepted, which means every claim waits for the 24h auto-revoke instead.
#
# WEBHOOK_SECRET: any long random string. Pass the same value as `secret_token`
# when registering the webhook:
#   curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -H 'Content-Type: application/json' \
#     -d '{"url":"https://instarishta.me/api/telegram/webhook",
#          "secret_token":"<TELEGRAM_WEBHOOK_SECRET>",
#          "allowed_updates":["callback_query"]}'
#
# ADMIN_IDS: comma-separated NUMERIC Telegram user ids allowed to settle
# payments — not usernames. Anyone in the group can see the buttons; only these
# ids can act on them. To find an id, have the person tap a button once and read
# the "rejected tap from <id>" line from the server log.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=

# ── Cron secret (renewal reminders + order sweep) ───────────────────────────
# Bearer token for /api/cron/*. Unset = those routes refuse to run.
# /api/cron/orders MUST be scheduled (hourly) unless pg_cron is enabled, or
# unconfirmed grants are never revoked.
CRON_SECRET=

# Shared secret between the Next app and the Cloudflare profile relay, used by
# the "Refresh profiles" button in /nizam and /api/cron/profiles-refresh to
# force jsdata.json to be re-read immediately. Must match PROFILES_PURGE_SECRET
# set as a Cloudflare Worker secret (`wrangler secret put PROFILES_PURGE_SECRET`).
# Never exposed to the browser. With this unset, the refresh route fails closed
# and the worker's refresh endpoint stays dead.
PROFILES_PURGE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# The three below are in use but were never documented here, so a fresh clone
# or a new environment came up quietly wrong rather than loudly broken.
# ─────────────────────────────────────────────────────────────────────────────

# The site's own origin, no trailing slash. Read through src/config/site.ts,
# which is the single source of truth for it.
#
# This one matters more than it looks. app/layout.tsx feeds it to
# `metadataBase`, and metadataBase resolves every *relative* metadata URL —
# so if it is unset or wrong, canonical tags and OG images across the entire
# site point somewhere else. Set it per environment; a preview deploy that
# inherits production's value will advertise production URLs.
NEXT_PUBLIC_SITE_URL=https://www.instarishta.me

# Supabase Dashboard → Settings → API → JWT Secret. Server-only.
#
# Powers the realtime bridge: /api/auth/supabase-token mints a short-lived JWT
# so useRealtimeProfile can subscribe to a member's own credit changes. It
# degrades quietly by design — without this the endpoint returns 204, the hook
# leaves `enabled` false, and callers fall back to polling. Live credit updates
# simply never appear, with nothing in the logs to say why. That silence is the
# reason it belongs in this file.
SUPABASE_JWT_SECRET=

# Set to exactly "1" to require a freshly-authenticated session for destructive
# admin actions in /nizam (see src/lib/admin-route.ts). Any other value, or
# unset, leaves the normal session check in place.
ADMIN_FRESH_SESSION=
